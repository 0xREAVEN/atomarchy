#!/bin/bash
# Installs the Omarchy Flatpak list once per list version (system scope).
set -uo pipefail

list=/usr/share/omarchy-atomic/flatpaks.txt
state_dir=/var/lib/omarchy-atomic
stamp="$state_dir/flatpaks.sha256"
mkdir -p "$state_dir"

hash=$(sha256sum "$list" | cut -d' ' -f1)
if [[ -f $stamp && $(<"$stamp") == "$hash" ]]; then
  echo "Omarchy Flatpaks already installed for this list."
  exit 0
fi

flatpak remote-add --if-not-exists --system flathub /etc/flatpak/remotes.d/flathub.flatpakrepo || true

mapfile -t apps < <(grep -vE '^\s*(#|$)' "$list")
failed=0
for app in "${apps[@]}"; do
  flatpak info --system "$app" &>/dev/null && continue
  flatpak install --system --noninteractive -y flathub "$app" || failed=1
done

# Retry on the next boot if anything failed (offline, Flathub down, ...).
(( failed )) || echo "$hash" >"$stamp"
exit 0
