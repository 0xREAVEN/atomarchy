#!/bin/bash

# omarchy:summary=Omarchy channels map to image tags on Bazzite

# Atomic (bootc) replacement installed by bazzite-omarchy; the Omadora
# original is kept in /usr/share/omarchy-atomic/orig/.

source /usr/libexec/omarchy-atomic/lib.sh

echo "Follow another channel by rebasing to another tag of the image, e.g.:"
echo "  sudo bootc switch <registry>/<image>:testing"
exit 1
