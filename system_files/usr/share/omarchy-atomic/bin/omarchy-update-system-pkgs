#!/bin/bash

# omarchy:summary=Update the system image (bootc / rpm-ostree) and layered packages
# omarchy:requires-sudo=true

# Replaces the dnf upgrade step of `omarchy update`. The whole OS, Omarchy
# included, comes from the container image: one transactional upgrade that
# lands as a new deployment on the next boot, with the previous one kept for
# `rpm-ostree rollback`.

set -e
source /usr/libexec/omarchy-atomic/lib.sh

echo -e "\e[32m\nUpdate system image\e[0m"

atomic_as_root rpm-ostree upgrade

if atomic_has_staged_deployment; then
  atomic_mark_reboot_required
fi
