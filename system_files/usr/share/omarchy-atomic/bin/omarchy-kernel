#!/bin/bash

# omarchy:summary=Show the kernel shipped by the image

# Atomic (bootc) replacement installed by bazzite-omarchy; the Omadora
# original is kept in /usr/share/omarchy-atomic/orig/.

source /usr/libexec/omarchy-atomic/lib.sh

case "${1:-get}" in
get|list) uname -r ;;
*)
  echo "The kernel comes with the Bazzite image. Kernel arguments: rpm-ostree kargs (or ujust)."
  exit 1
  ;;
esac
