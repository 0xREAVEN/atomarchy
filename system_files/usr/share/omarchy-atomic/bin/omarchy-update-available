#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.

# The top-bar update indicator runs this unprivileged. A new image is
# detected by comparing the registry digest of the followed tag with the
# booted (or already staged) deployment, so no root and no polkit prompt.

set -uo pipefail

status_json=$(rpm-ostree status --json 2>/dev/null) || { echo "Omarchy is up to date"; exit 1; }

ref=$(jq -r '.deployments[] | select(.booted == true) | .["container-image-reference"] // empty' <<<"$status_json")
known=$(jq -r '[.deployments[] | select(.booted == true or .staged == true) | .["container-image-reference-digest"] // empty] | .[]' <<<"$status_json")

if [[ -z $ref ]]; then
  echo "Omarchy is up to date"
  exit 1
fi

# ostree-image-signed:docker://ghcr.io/x/y:tag, ostree-unverified-registry:ghcr.io/x/y:tag
image=${ref#*docker://}
image=${image#ostree-unverified-registry:}
image=${image#ostree-remote-registry:*:}

remote=$(timeout 30 skopeo inspect --no-tags "docker://$image" 2>/dev/null | jq -r '.Digest // empty')

if [[ -n $remote ]] && ! grep -qxF "$remote" <<<"$known"; then
  echo "${image##*/} new image ${remote:7:12}"
  exit 0
fi

echo "Omarchy is up to date"
exit 1
