#!/bin/bash

# omarchy:summary=Remove the named packages if they're installed (layered packages only on Bazzite).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

# Only packages layered with rpm-ostree can be uninstalled. Packages that are
# part of the image stay: removing them would need `rpm-ostree override
# remove`, which diverges from the image for every future update, so it is
# never done implicitly.

source /usr/libexec/atomarchy/lib.sh

declare -A layered=()
while IFS= read -r name; do
  [[ -n $name ]] && layered[$name]=1
done < <(atomic_layered_packages)

to_remove=()
in_image=()
for pkg in "$@"; do
  rpm -q -- "$pkg" &>/dev/null || continue
  if [[ -n ${layered[$pkg]:-} ]]; then
    to_remove+=("$pkg")
  else
    in_image+=("$pkg")
  fi
done

if (( ${#in_image[@]} )); then
  atomic_note "Part of the image, left installed: ${in_image[*]} (to force: sudo rpm-ostree override remove ${in_image[*]})"
fi

if (( ${#to_remove[@]} )); then
  atomic_as_root rpm-ostree uninstall -y -- "${to_remove[@]}" || exit 1
  atomic_mark_reboot_required
  atomic_note "Removed from the next deployment; takes effect after a reboot."
fi

exit 0
