#!/bin/bash

# omarchy:summary=Snapshots: ostree keeps the previous deployment (create = no-op, restore = rollback)

# Atomic (bootc) replacement installed by Atomarchy; the Omadora
# original is kept in /usr/share/atomarchy/orig/.

source /usr/libexec/atomarchy/lib.sh

case "${1:-}" in
create)
  # 127 tells omarchy-update that Snapper is deliberately absent.
  exit 127
  ;;
restore)
  echo "Rolling back to the previous deployment (rpm-ostree rollback)."
  atomic_as_root rpm-ostree rollback && atomic_mark_reboot_required
  echo "Reboot to boot the previous system. The boot menu also lists it."
  ;;
*)
  echo "Usage: omarchy-snapshot <create|restore>" >&2
  exit 1
  ;;
esac
