#!/bin/bash

# omarchy:summary=Repair the system by rebasing onto the image

# Atomic (bootc) replacement installed by Atomarchy; the Omadora
# original is kept in /usr/share/atomarchy/orig/.

source /usr/libexec/atomarchy/lib.sh

echo "Packages come from the image. To get back to a pristine image:"
echo "  rpm-ostree reset        # drop layered packages and overrides"
echo "  rpm-ostree rollback     # boot the previous deployment"
exit 0
